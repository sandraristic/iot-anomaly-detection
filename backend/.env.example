# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Upload/data limits
MAX_UPLOAD_BYTES=734003200
MAX_TRAIN_ROWS=500000
MAX_PREDICT_ROWS=500000
MAX_COLUMNS=1000
MAX_ENCODED_FEATURES=50000

# Training resource limits
MAX_CONCURRENT_TRAININGS=2
TRAIN_TIMEOUT_SECONDS=900

# Saved models expire after 24 hours
MODEL_RETENTION_SECONDS=86400

# Simple per-IP API rate limits
TRAIN_RATE_LIMIT=10
TRAIN_RATE_WINDOW_SECONDS=3600
PREDICT_RATE_LIMIT=120
PREDICT_RATE_WINDOW_SECONDS=3600
